# Primary LLM document agent. PDF parsing stays in the browser; interpretation
# is performed by exactly one explicitly selected model.
NODE_ENV=development
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
PAPERWORK_MODEL_COUNCIL_ENABLED=false
PAPERWORK_DOCUMENT_AGENT_ENABLED=false

# Local live calls require NODE_ENV=development and an exact loopback application
# origin. The legacy Model Council and the primary document agent have separate
# enable flags.

# Hosted private-beta mode. Leave disabled for local development. Production
# remains fail-closed unless every required value is valid, the DB D1 binding is
# available, and exactly one hosted provider is selected below.
PAPERWORK_PUBLIC_GATEWAY_MODE=disabled
PAPERWORK_PUBLIC_APP_ORIGIN=
PAPERWORK_PUBLIC_PROVIDER=

# SHA-256 of a strong private-beta access pass, never the raw pass. Set the
# acknowledgement to true only after a real hard spend cap/alert is configured
# in the chosen provider project; PaperWork cannot verify that external setting.
PAPERWORK_GATEWAY_ACCESS_TOKEN_SHA256=
PAPERWORK_PROVIDER_SPEND_CAP_CONFIGURED=false

# Optional bounded overrides. Defaults shown. Cost units are a byte-based
# admission estimate, not a token counter or spend ceiling. Keep a provider cap.
PAPERWORK_GATEWAY_SESSION_HOURS=8
PAPERWORK_GATEWAY_GRANT_MINUTES=5
PAPERWORK_GATEWAY_METADATA_RETENTION_HOURS=24
PAPERWORK_GATEWAY_MAX_SESSIONS_PER_HOUR=50
PAPERWORK_GATEWAY_MAX_OPEN_GRANTS=3
PAPERWORK_GATEWAY_MAX_GRANT_ISSUES_PER_HOUR=10
PAPERWORK_GATEWAY_GLOBAL_MAX_GRANT_ISSUES_PER_HOUR=100
PAPERWORK_GATEWAY_MAX_REQUESTS_PER_HOUR=5
PAPERWORK_GATEWAY_SESSION_DAILY_COST_UNITS=200
PAPERWORK_GATEWAY_GLOBAL_DAILY_COST_UNITS=1000
PAPERWORK_GATEWAY_MAX_CONCURRENT_REQUESTS=2

# Hosted commercial API. Choose an exact model ID available to your project.
OPENAI_API_KEY=
OPENAI_MODEL=

# Hosted commercial API. Choose an exact Claude model ID available to you.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Open-weight models are available, but hosted Mistral inference is metered.
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Accepted values: https://api.mistral.ai, https://api.us.mistral.ai, or https://api.eu.mistral.ai
MISTRAL_BASE_URL=https://api.mistral.ai

# Open-weight models are available, but hosted DeepSeek inference is metered.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Self-hosted structured output. In v1 the browser calls this origin directly,
# so only an exact canonical HTTP localhost/127.0.0.1 origin (no trailing slash,
# path, query, fragment or credentials) is accepted. Ollama must be selected
# separately from hosted providers; the PaperWork gateway is not in this hop.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
