# Optional model council. The trusted browser-local Action Pack works without it.
# Cloudflare's local Worker receives this as an explicit environment binding.
NODE_ENV=development
PAPERWORK_MODEL_COUNCIL_ENABLED=false

# Live council calls require NODE_ENV=development and a loopback application
# origin. Missing, test, production and unexpected values fail closed. Public
# use first needs real user authorization, distributed quotas, replay protection
# and provider spend caps.

# Hosted commercial API. Choose an exact model ID available to your project.
OPENAI_API_KEY=
OPENAI_MODEL=

# Hosted commercial API. Choose an exact Claude model ID available to you.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Open-weight models are available, but hosted Mistral inference is metered.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
# Accepted values: https://api.mistral.ai, https://api.us.mistral.ai, or https://api.eu.mistral.ai
MISTRAL_BASE_URL=https://api.mistral.ai

# Open-weight models are available, but hosted DeepSeek inference is metered.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Self-hosted structured output. In v1 the browser calls this origin directly,
# so only an exact canonical HTTP localhost/127.0.0.1 origin (no trailing slash,
# path, query, fragment or credentials) is accepted. Ollama must be selected
# separately from hosted providers; the PaperWork gateway is not in this hop.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
